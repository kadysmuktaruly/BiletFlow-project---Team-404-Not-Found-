# BiletFlow environment. Copy to .env and adjust.
#   cp .env.example .env
# Never commit .env — it is gitignored. No real secrets belong in this file either.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=biletflow
POSTGRES_DB=biletflow

# Host port for the Postgres container. 5433 by default, not 5432, so BiletFlow can run
# alongside another project's Postgres without a port collision.
POSTGRES_PORT=5433

# Async driver — asyncpg, always. A sync `postgresql://` URL here will fail at startup:
# this service uses async SQLAlchemy end to end and never opens a sync session.
# From the host (running the API locally):
DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5433/biletflow
# From inside Docker Compose the API overrides this to: ...@db:5432/biletflow

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=BiletFlow API
PUBLIC_BASE_URL=http://localhost:3000

# SRS 4.3.1 — how long a seat hold survives before the sweep may release it.
SEAT_HOLD_TTL_SECONDS=600

# SRS 3.3 — one-time Paid Sales Activation Fee, in whole KZT. The real amount is an open
# decision (SRS 12); this is a placeholder for the demonstration.
ACTIVATION_FEE_KZT=5000

# SRS 7 — KZT for the initial Kazakhstan release.
CURRENCY=KZT

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Scanner (apps/scanner)
# ---------------------------------------------------------------------------
# Expo runs on the device, so localhost is the phone, not your laptop. Use the LAN IP of
# the machine running the API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Deferred to later weeks — documented now so nobody invents a different name.
# ---------------------------------------------------------------------------
# JWT_SECRET=                 # week 3, auth. Generate per environment; never commit one.
# JWT_ACCESS_TTL_SECONDS=900  # week 3
# SMTP_URL=                   # week 3, transactional email (SRS 4.10)
# S3_ENDPOINT_URL=            # week 7, ticket PDF storage (SRS 9)
