# BiletFlow environment. Copy to .env and adjust.
#   cp .env.example .env
# Never commit .env — it is gitignored. No real secrets belong in this file either.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=biletflow
POSTGRES_DB=biletflow

# Host port for the Postgres container. 5433 by default, not 5432, so BiletFlow can run
# alongside another project's Postgres without a port collision.
POSTGRES_PORT=5433

# Async driver — asyncpg, always. A sync `postgresql://` URL here will fail at startup:
# this service uses async SQLAlchemy end to end and never opens a sync session.
# From the host (running the API locally):
DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5433/biletflow
# From inside Docker Compose the API overrides this to: ...@db:5432/biletflow

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# development | test | production. Outside development/test, JWT_SECRET is required.
ENVIRONMENT=development
APP_NAME=BiletFlow API
# The web app's origin. Email links (verify email, reset password) point here, and it is
# always an allowed CORS origin.
PUBLIC_BASE_URL=http://localhost:3000
# Extra allowed CORS origins, comma-separated (e.g. the web app opened via your LAN IP).
CORS_ORIGINS=
# Host port for the API container (docker compose).
API_PORT=8000

# SRS 4.3.1 — how long a seat hold survives before the sweep may release it.
SEAT_HOLD_TTL_SECONDS=600

# SRS 3.3 — one-time Paid Sales Activation Fee, in whole KZT. The real amount is an open
# decision (SRS 12); this is a placeholder for the demonstration.
ACTIVATION_FEE_KZT=5000

# SRS 7 — KZT for the initial Kazakhstan release.
CURRENCY=KZT

# ---------------------------------------------------------------------------
# Web (apps/web)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Scanner (apps/scanner)
# ---------------------------------------------------------------------------
# Expo runs on the device, so localhost is the phone, not your laptop. Use the LAN IP of
# the machine running the API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Auth (SRS 4.1)
# ---------------------------------------------------------------------------
# Signs access tokens and the email verify / password reset links. Leave empty in
# development to use the built-in insecure dev secret. Anywhere else it is required and
# must be at least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Lifetimes in seconds: access 15 min, refresh 30 days, verify link 24 h, reset link 1 h.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
EMAIL_VERIFY_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
# Secure flag on the refresh-token cookie. false for http://localhost, true behind HTTPS.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Email (SRS 4.10). In development, Mailpit catches everything: http://localhost:8025
# ---------------------------------------------------------------------------
# From the host. Inside Docker Compose the API overrides this to SMTP_HOST=mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=BiletFlow <no-reply@biletflow.local>
# Host ports for Mailpit (docker compose).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Deferred to later work — documented now so nobody invents a different name.
# ---------------------------------------------------------------------------
# S3_ENDPOINT_URL=            # ticket PDF storage (SRS 9)
